# stackchan-mcp gateway environment variables
# Copy this file to `.env` and fill in your values.

# --- ESP32 authentication ---
# Token sent by the ESP32 as `Authorization: Bearer <token>`.
# Set the same value in the firmware's WiFi config UI (token field).
STACKCHAN_TOKEN=your-secret-token-here

# Legacy alias (still supported, prefer STACKCHAN_TOKEN above).
BEARER_TOKEN=

# --- WebSocket server (ESP32 -> gateway) ---
HOST=0.0.0.0
WS_PORT=8765

# --- HTTP capture server (ESP32 -> gateway, photo upload) ---
CAPTURE_PORT=8766

# Full public capture URL sent to the ESP32.
# Use this for remote tunnel setups such as Tailscale Funnel.
# Example: https://stackchan.example.ts.net:8443/capture
VISION_URL=

# Optional separate bearer token for HTTP photo uploads to VISION_URL.
# If empty, STACKCHAN_TOKEN is reused.
VISION_TOKEN=

# LAN IP of THIS machine, as seen from the ESP32.
# The gateway tells the ESP32 to POST captured photos to this address.
# Required if you want take_photo to work and VISION_URL is not set.
# Example: something like 192.168.x.y on a typical home network
# (run `ifconfig` / `ip addr` to find your host's LAN IP).
VISION_HOST=

# --- nerv0x engines (yorishiro fork) -----------------------------------------
# STT: whisper.cpp on the nerv0x GPU box (defaults shown; usually unset).
# STACKCHAN_STT_ENGINE=nerv0x-whisper
# STACKCHAN_WHISPER_URL=http://127.0.0.1:9766/inference
# STACKCHAN_WHISPER_LANGUAGE=
# TTS: Qwen3-TTS on the nerv0x GPU box (OpenAI-compatible).
# STACKCHAN_TTS_ENGINE=nerv0x
# STACKCHAN_TTS_URL=http://127.0.0.1:8002/v1/audio/speech
# STACKCHAN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
# Spoken-reply budget: deterministic cap applied after Hermes answers so
# realtime-paced device delivery (60 ms/frame) never stretches the turn.
# STACKCHAN_MAX_REPLY_CHARS=160
# STACKCHAN_MAX_REPLY_SENTENCES=2
# Voice-turn recognition language (default ja upstream; pt for PT flow).
# STACKCHAN_STT_LANGUAGE=ja
# Device-driven voice loop: point the ESP32 listen hook at our own
# /voice_turn endpoint so tap → STT → Hermes → TTS runs in-process.
# STACKCHAN_AUDIO_HOOK_URL=http://127.0.0.1:8766/voice_turn
# STACKCHAN_AUDIO_HOOK_TOKEN=
# Hermes API server for voice turns (the profile gateway).
# HERMES_API_URL=http://127.0.0.1:8644
# HERMES_API_KEY=
